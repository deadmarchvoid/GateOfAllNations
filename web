<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GateOfAllNations</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #f8fafc;
    }

    .container {
      width: min(90%, 600px);
      padding: 40px;
      border-radius: 16px;
      background: #1e293b;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }

    h1 {
      margin: 0 0 16px;
      font-size: 36px;
    }

    p {
      margin: 10px 0;
      color: #cbd5e1;
      line-height: 1.6;
    }

    .status {
      display: inline-block;
      margin-top: 20px;
      padding: 10px 18px;
      border-radius: 999px;
      background: #166534;
      color: #dcfce7;
      font-weight: bold;
    }

    .info {
      margin-top: 25px;
      padding: 15px;
      border-radius: 10px;
      background: #0f172a;
      color: #94a3b8;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <main class="container">
    <h1>GateOfAllNations</h1>

    <p>
      The application is running successfully.
    </p>

    <div class="status">
      ● Online
    </div>

    <div class="info">
      Railway → Docker → Node.js → HTTP
      <br />
      Deployment test successful.
    </div>
  </main>
</body>
</html>
